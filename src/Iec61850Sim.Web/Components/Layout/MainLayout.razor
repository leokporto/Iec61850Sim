@inherits LayoutComponentBase
@using Iec61850Sim.Web.Theme

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h5" Class="ml-3">IEC 61850 Simulator</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Settings"
                       Color="Color.Inherit"
                       Href="/settings" />
    </MudAppBar>
    <MudMainContent >
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = MudThemeConfiguration.Create();
}

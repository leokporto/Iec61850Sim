@page "/"

@using Iec61850Sim.Web.Components.Controls
@inject RuntimeEngine RunEngine
@inject IModelNode ModelTree

<PageTitle>IEC 61850 Simulator</PageTitle>

<MudGrid Spacing="3">

    <MudItem xs="12">
        <MudPaper Elevation="1" Class="pa-3">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle1"><b>Server</b></MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="StartServer">Start</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="StopServer">Stop</MudButton>
                <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
                <MudText Typo="Typo.subtitle1"><b>Simulation</b></MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartSimulation">Start</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="StopSimulation">Stop</MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="3">
        <MudPaper Elevation="1" Class="pa-2" Style="min-height: 400px;">
            <MudText Typo="Typo.subtitle2" Class="mb-2 px-1">Model Tree</MudText>
            <ModelTreeView RootNode="@ModelTree" OnNodeSelected="@OnNodeSelected" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudPaper Elevation="1" Class="pa-3" Style="min-height: 400px;">
            <MudText Typo="Typo.subtitle2" Class="mb-3">
                @(_selectedNode is not null ? _selectedNode.Name : "Device Points")
            </MudText>
            <DevicePointsPanel SelectedNode="@_selectedNode" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="3">
        <MudPaper Elevation="1" Class="pa-2" Style="min-height: 400px; position: sticky; top: 72px;">
            <SwitchControlPanel />
        </MudPaper>
    </MudItem>

</MudGrid>

@code {
    private IModelNode? _selectedNode;

    private void OnNodeSelected(IModelNode node)
    {
        _selectedNode = node;
    }

    void StartServer() => RunEngine.StartServer();
    void StopServer() => RunEngine.StopServer();
    void StartSimulation() => RunEngine.StartSimulation();
    void StopSimulation() => RunEngine.StopSimulation();
}

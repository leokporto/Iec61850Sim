@page "/"

@using Iec61850Sim.Web.Components.Controls
@inject Iec61850Sim.Core.Biz.RuntimeEngine RunEngine

<PageTitle>Home</PageTitle>

<h3>Iec61850 tiny sim</h3>

<p>
    Bem vindo ao pequeno simulador de IEC61850.
</p>

<div class="container-fluid">

    <!-- Top controls -->
    <div class="row g-3 mb-3">

        <!-- Server operations -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-header">
                    Server
                </div>
                <div class="card-body d-grid gap-2">

                    <button class="btn btn-success btn-sm"
                            @onclick="StartServer">
                        Start
                    </button>

                    <button class="btn btn-danger btn-sm"
                            @onclick="StopServer">
                        Stop
                    </button>

                </div>
            </div>
        </div>

        <!-- Simulation operations -->
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-header">
                    Simulation
                </div>
                <div class="card-body d-grid gap-2">

                    <button class="btn btn-success btn-sm"
                            @onclick="StartSimulation">
                        Start
                    </button>

                    <button class="btn btn-danger btn-sm"
                            @onclick="StopSimulation">
                        Stop
                    </button>

                </div>
            </div>
        </div>

        <!-- Filter -->
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    Filter
                </div>

                <div class="card-body">

                    <div class="row mb-2">
                        <div class="col-4">
                            Logical Device
                        </div>
                        <div class="col-8">
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="LogicalDevice" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            Logical Node
                        </div>
                        <div class="col-8">
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="LogicalNode" />
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Measures grid -->

    <div class="row">
        <div class="col-12">

            <MeasuresGrid LogicalDevice="@LogicalDevice"
                          LogicalNode="@LogicalNode" />

        </div>
    </div>

</div>

@code
{
    private string LogicalDevice = "";
    private string LogicalNode = "";

    void StartServer()
    {
        RunEngine.StartServer();
    }

    void StartSimulation()
    {
        RunEngine.StartSimulation();
    }

    void StopSimulation()
    {
        RunEngine.StopSimulation();
    }

    void StopServer()
    {
        RunEngine.StopServer();
    }
}
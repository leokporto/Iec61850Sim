@page "/"

@using Iec61850Sim.Web.Components.Controls

<PageTitle>Home</PageTitle>

<h1>Iec61850 tiny sim</h1>

<p>
    Bem vindo ao pequeno simulador de 61850. 

    Navegue pelo filtro para selecionar os pontos apenas de um determinado Logical device ou logical node.
</p>

<div class="container card">
    <label>Logical Device:</label><InputText @bind-Value="@LogicalDevice" />
    <label>Logical Device:</label><InputText @bind-Value="@LogicalNode" />
</div>

<br />

<div class="container">
    <MeasuresGrid LogicalDevice="@LogicalDevice" LogicalNode="@LogicalNode" />
</div>

@code
{
    private string LogicalDevice = "";
    private string LogicalNode = "";
}

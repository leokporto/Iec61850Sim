@using Iec61850Sim.Web.Model.Devices
@inject PointRegistry registry

<h3></h3>

<table class="table table-sm table-striped">
    <thead>
    <tr>
        <th>Reference</th>
        <th>Value</th>
        <th>Timestamp</th>
    </tr>
    </thead>

    <tbody>
    @foreach (DevicePoint point in Measures)
    {
        <tr>
            <td>@point.Reference</td>
            <td>@point.Value</td>
            
        </tr>
    }
    </tbody>
</table>
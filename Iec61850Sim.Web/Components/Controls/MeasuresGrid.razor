@using Iec61850Sim.Core.Model
@inject PointRegistry registry

<h3>Medidas</h3>

<table class="table table-sm table-striped table-borderless">
    <thead>
    <tr>
        <th>Reference</th>
        <th>LogicalNode</th>
        <th>DataObject</th>
        <th>Value</th>
        <th>Timestamp</th>
    </tr>
    </thead>

    <tbody>
    @foreach (DevicePoint point in Measures)
    {
        <tr @key="point.Reference">
            <td>@point.Reference</td>
            <td>@point.LogicalNode</td>
            <td>@point.DataObject</td>
            <td>@point.Value</td>
            <td>@point.Timestamp.ToLocalTime()</td>
        </tr>
    }
    </tbody>
</table>